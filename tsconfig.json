{
	"compilerOptions": {
		"target": "ES2020",
		"module": "commonjs",
		"moduleResolution": "node",
		"outDir": "./dist",
		"rootDir": "./src",

		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,

		// (optional but nice)
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true
	}
}
